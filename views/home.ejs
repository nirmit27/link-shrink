<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Link Shortener</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            width: 100vw;
            height: 100vh;
        }
    </style>

    <!-- Tailwind CSS - CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/public/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/public/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/public/favicon-16x16.png">
    <link rel="manifest" href="/public/site.webmanifest">
</head>

<body class="flex items-center justify-between flex-col gap-2">
    <div class="mt-8 w-3/4 md:w-2/4 max-w-4xl mx-auto">
        <div class="mb-6">
            <h2 class="text-3xl font-bold mb-4 text-slate-800">
                Link Shortener
            </h2>
            <p class="text-md text-justify">
                This is a RESTful API built with Express.js for shortening and managing URLs.
            </p>
            <p class="text-md text-justify">
                It provides endpoints for generating, retrieving, and visiting short URLs.
            </p>
        </div>
        <div class="mt-6 mb-12">
            <h2 class="text-2xl font-bold mb-2 text-slate-800">Documentation</h2>

            <!-- Documentation -->
            <details class="p-1">
                <summary class="text-lg mb-2">
                    Generate Short URL
                </summary>
                <code
                    class="font-bold text-slate-700 bg-slate-200 px-2 py-1 my-2 rounded-md text-sm">POST /api/shorten</code>
                <p class="my-2">
                    Creates a shortened URL from a long URL. Send a POST request with the original URL in the request
                    body.
                </p>
            </details>

            <details class="p-1">
                <summary class="text-lg mb-2">
                    Retrieve Original URL
                </summary>
                <code
                    class="font-bold text-slate-700 bg-slate-200 px-2 py-1 my-2 rounded-md text-sm">GET /api/url/:id</code>
                <p class="my-2">
                    Retrieves the original URL for a given short URL ID. Returns the full URL information.
                </p>
            </details>

            <details class="p-1">
                <summary class="text-lg mb-2">
                    Redirect to Original URL
                </summary>
                <code class="font-bold text-slate-700 bg-slate-200 px-2 py-1 my-2 rounded-md text-sm">GET /:id</code>
                <p class="my-2">
                    Automatically redirects to the original URL when visiting the shortened link.
                </p>
            </details>

        </div>
    </div>

    <div
        class="md:w-2/5 md:rounded-md md:mb-2 md:shadow-sm md:shadow-slate-200 w-full bottom-0 p-3 text-center text-sm bg-slate-200">
        Made with &#129505; by <a href="https://github.com/nirmit27" target="_blank" rel="noopener noreferrer"
            class="text-slate-800 font-semibold hover:text-blue-800">Nirmit Mishra</a>.
    </div>

</body>

</html>